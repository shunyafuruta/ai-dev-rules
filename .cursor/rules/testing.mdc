## テストデータ管理

### ファクトリーパターン

```typescript
/**
 * テスト用のユーザーデータを生成
 */
function createTestUser(overrides?: Partial<User>): User {
  return {
    id: `test-user-${Date.now()}`,
    name: 'Test User',
    email: `test-${Date.now()}@example.com`,
    role: 'staff',
    createdAt: new Date(),
    updatedAt: new Date(),
    ...overrides,
  };
}

/**
 * テスト用の契約データを生成
 */
function createTestContract(overrides?: Partial<Contract>): Contract {
  return {
    id: `test-contract-${Date.now()}`,
    contractNumber: `C-TEST-${Date.now()}`,
    studentId: 'test-student-123',
    status: 'draft',
    startDate: new Date(),
    monthlyFee: 50000,
    createdAt: new Date(),
    updatedAt: new Date(),
    ...overrides,
  };
}

export { createTestUser, createTestContract };
```

