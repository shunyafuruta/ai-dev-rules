  windowMs: 60 * 1000, // 1分
  max: 100, // 最大100リクエスト/分
  message: 'リクエスト数が上限に達しました。しばらくしてから再試行してください。',
});

// 適用
app.post('/api/auth/login', loginLimiter, login);
app.use('/api/', apiLimiter);

export { loginLimiter, apiLimiter };
```

### 9. 入力検証とサニタイゼーション

**厳格な入力検証**

```typescript
import { z } from 'zod';
import validator from 'validator';

/**
 * メールアドレスのバリデーション（厳格）
 */
const EmailSchema = z
  .string()
  .email('有効なメールアドレスを入力してください')
  .max(255)
  .refine((email) => validator.isEmail(email, { allow_utf8_local_part: false }), {
    message: 'メールアドレスの形式が正しくありません',
  });

/**
 * 電話番号のバリデーション（日本の電話番号形式）
 */
const PhoneNumberSchema = z
  .string()
  .regex(/^0\d{1,4}-?\d{1,4}-?\d{4}$/, '電話番号の形式が正しくありません')
  .transform((val) => val.replace(/-/g, '')); // ハイフンを削除

/**
 * URLのバリデーション（ホワイトリスト方式）
 */
const ALLOWED_URL_DOMAINS = ['example.com', 'trusted-site.com'];

const SafeUrlSchema = z
  .string()
  .url('有効なURLを入力してください')
  .refine((url) => {
    const { hostname } = new URL(url);
    return ALLOWED_URL_DOMAINS.some((domain) => hostname.endsWith(domain));
  }, {
    message: '許可されていないドメインです',
  });

export { EmailSchema, PhoneNumberSchema, SafeUrlSchema };
```

### 10. 安全でない逆シリアル化対策

**JSONのみを使用し、evalを禁止**

```typescript
// ❌ 危険: evalの使用（絶対禁止）
