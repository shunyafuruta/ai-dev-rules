## バックエンドパフォーマンス

### 1. データベースクエリ最適化

#### インデックスの活用

```prisma
model contracts {
  id              String   @id @default(uuid())
  student_id      String
  status          String
  created_at      DateTime @default(now())

  // 検索条件に応じたインデックス
  @@index([student_id, status])
  @@index([created_at])
  @@index([status, created_at])
}
```

#### N+1問題の回避

```typescript
// ❌ N+1問題
const contracts = await db.contracts.findMany();
for (const contract of contracts) {
  const student = await db.students.findUnique({ where: { id: contract.student_id } });
}

// ✅ include で一度に取得
const contracts = await db.contracts.findMany({
  include: {
    student: true,
  },
});
```

#### クエリの並列化

```typescript
// ❌ 逐次実行（遅い）
const users = await db.users.findMany();
const contracts = await db.contracts.findMany();
const payments = await db.payments.findMany();

// ✅ 並列実行（速い）
const [users, contracts, payments] = await Promise.all([
  db.users.findMany(),
  db.contracts.findMany(),
  db.payments.findMany(),
]);
```

### 2. キャッシュ戦略

#### Redis キャッシュ

```typescript
import Redis from 'ioredis';

const redis = new Redis(process.env.REDIS_URL);

/**
 * キャッシュ付きデータ取得
 *
 * @param key - キャッシュキー
 * @param fetchFn - データ取得関数
 * @param ttl - キャッシュ有効期限（秒）
 */
async function getCached<T>(
  key: string,
  fetchFn: () => Promise<T>,
  ttl: number = 300
): Promise<T> {
  // キャッシュから取得
  const cached = await redis.get(key);
  if (cached) {
    return JSON.parse(cached);
  }

  // データベースから取得
  const data = await fetchFn();

  // キャッシュに保存
  await redis.setex(key, ttl, JSON.stringify(data));

  return data;
}

/**
 * ダッシュボード統計（キャッシュ版）
 */
async function getDashboardStats() {
  return getCached(
    'dashboard:stats',
    async () => {
      const [totalContracts, activeContracts, totalRevenue] = await Promise.all([
        db.contracts.count(),
        db.contracts.count({ where: { status: 'active' } }),
        db.payments.aggregate({
          _sum: { amount: true },
          where: { status: 'paid' },
        }),
      ]);

      return {
        totalContracts,
        activeContracts,
        totalRevenue: totalRevenue._sum.amount || 0,
      };
    },
    60 // 1分間キャッシュ
  );
}

export { getCached, getDashboardStats };
```

### 3. レート制限とスロットリング

```typescript
import rateLimit from 'express-rate-limit';

// APIレート制限
const apiLimiter = rateLimit({
  windowMs: 60 * 1000, // 1分
  max: 100, // 最大100リクエスト
  message: 'リクエスト数が上限に達しました',
  standardHeaders: true,
  legacyHeaders: false,
});

app.use('/api/', apiLimiter);

export { apiLimiter };
```

### 4. 非同期処理（ジョブキュー）

```typescript
import Bull from 'bull';

// ジョブキューを作成
const emailQueue = new Bull('email', process.env.REDIS_URL);

/**
 * メール送信ジョブを追加（非同期）
 */
async function sendEmailAsync(to: string, subject: string, body: string): Promise<void> {
  await emailQueue.add({
    to,
    subject,
    body,
  });
}

// ジョブの処理
emailQueue.process(async (job) => {
  const { to, subject, body } = job.data;
  await sendEmail(to, subject, body);
});

export { sendEmailAsync };
```

