## 構造化ログ

### JSON形式のログ出力

```typescript
/**
 * 構造化ログエントリ
 */
interface StructuredLog {
  timestamp: string;
  level: LogLevel;
  message: string;
  userId?: string;
  requestId?: string;
  method?: string;
  url?: string;
  statusCode?: number;
  duration?: number;
  error?: {
    message: string;
    stack?: string;
    name: string;
  };
  [key: string]: unknown;
}

/**
 * リクエストログ
 */
function logRequest(req: Request, res: Response, duration: number): void {
  logger.info('HTTP Request', {
    requestId: req.id,
    method: req.method,
    url: req.url,
    statusCode: res.statusCode,
    duration,
    userId: req.user?.id,
    ipAddress: getClientIP(req),
    userAgent: req.headers['user-agent'],
  });
}

export { logRequest };
```

