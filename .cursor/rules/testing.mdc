## E2Eテスト

### テストフレームワーク

- **Playwright**: 高速で信頼性の高いE2Eテスト

### E2Eテストの配置

```
tests/
└── e2e/
    ├── auth.spec.ts
    ├── contract-search.spec.ts
    └── contract-create.spec.ts
```

### E2Eテストの基本構成

```typescript
import { test, expect } from '@playwright/test';

test.describe('契約検索機能', () => {
  test.beforeEach(async ({ page }) => {
    // ログイン
    await page.goto('http://localhost:5173/login');
    await page.fill('[name="email"]', 'test@example.com');
    await page.fill('[name="password"]', 'password123');
    await page.click('button[type="submit"]');
    await page.waitForURL('http://localhost:5173/dashboard');
  });

  test('契約番号で検索できる', async ({ page }) => {
    // 契約検索ページに移動
    await page.goto('http://localhost:5173/contracts');

    // 契約番号で検索
    await page.fill('[name="contractNumber"]', 'C-2024-001');
    await page.click('button:has-text("検索")');

    // 検索結果を確認
    await expect(page.locator('table tbody tr')).toHaveCount(1);
    await expect(page.locator('table tbody tr:first-child')).toContainText('C-2024-001');
  });

  test('ステータスでフィルタリングできる', async ({ page }) => {
    await page.goto('http://localhost:5173/contracts');

    // ステータスフィルタを選択
    await page.selectOption('[name="status"]', 'active');
    await page.click('button:has-text("検索")');

    // 全ての結果が「進行中」ステータスであることを確認
    const rows = page.locator('table tbody tr');
    const count = await rows.count();

    for (let i = 0; i < count; i++) {
      await expect(rows.nth(i)).toContainText('進行中');
    }
  });
});
```

