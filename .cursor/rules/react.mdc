## 5. コンポーネント設計パターン

### Presentation / Container パターン

**ロジックとUIを分離する**

```typescript
// ✅ Presentation Component（UI のみ）
interface ContractListViewProps {
  contracts: Contract[];
  isLoading: boolean;
  onSelect: (id: string) => void;
}

function ContractListView({ contracts, isLoading, onSelect }: ContractListViewProps) {
  // 早期リターン: ローディング中
  if (isLoading) {
    return <LoadingSpinner />;
  }

  return (
    <div className="space-y-4">
      {contracts.map((contract) => (
        <ContractCard
          key={contract.id}
          contract={contract}
          onSelect={() => onSelect(contract.id)}
        />
      ))}
    </div>
  );
}

// ✅ Container Component（ロジックのみ）
function ContractListContainer() {
  const { data: contracts = [], isLoading } = useQuery({
    queryKey: ['contracts'],
    queryFn: fetchContracts,
  });

  const navigate = useNavigate();

  // React Compilerが自動最適化（useCallback不要）
  const handleSelect = (id: string) => {
    navigate(`/contracts/${id}`);
  };

  return (
    <ContractListView
      contracts={contracts}
      isLoading={isLoading}
      onSelect={handleSelect}
    />
  );
}

export { ContractListContainer as ContractList };
```

### カスタムフックの作成

**ロジックを再利用可能にする**

```typescript
/**
 * 契約データを取得するカスタムフック
 *
 * @param contractId - 取得対象の契約ID
 * @returns 契約データ、ローディング状態、エラー情報
 */
function useContract(contractId: string | null) {
  return useQuery({
    queryKey: ['contract', contractId],
    queryFn: () => fetchContract(contractId!),
    enabled: contractId !== null,
  });
}

/**
 * 契約の更新を行うカスタムフック
 *
 * @returns 契約更新関数、ローディング状態、エラー情報
 */
function useContractUpdate() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: (data: ContractUpdateInput) => updateContract(data),
    onSuccess: (updatedContract) => {
      // キャッシュを更新
      queryClient.invalidateQueries({ queryKey: ['contracts'] });
      queryClient.setQueryData(['contract', updatedContract.id], updatedContract);
    },
  });
}

export { useContract, useContractUpdate };
```

### Context API の適切な使用

**グローバルな状態管理（認証、テーマなど）**

```typescript
import { createContext, useContext, useReducer } from 'react';
import type { ReactNode } from 'react';

// State型定義
interface AuthState {
  user: User | null;
  isAuthenticated: boolean;
}

// Action型定義
type AuthAction =
  | { type: 'LOGIN'; payload: User }
  | { type: 'LOGOUT' };

// Context型定義
interface AuthContextValue {
  state: AuthState;
  login: (user: User) => void;
  logout: () => void;
}

// Context作成
const AuthContext = createContext<AuthContextValue | undefined>(undefined);

// Reducer関数
function authReducer(state: AuthState, action: AuthAction): AuthState {
  switch (action.type) {
    case 'LOGIN':
      return {
        user: action.payload,
        isAuthenticated: true,
      };
    case 'LOGOUT':
      return {
        user: null,
        isAuthenticated: false,
      };
    default:
      return state;
  }
}

// Provider Component
interface AuthProviderProps {
  children: ReactNode;
}

function AuthProvider({ children }: AuthProviderProps) {
  const [state, dispatch] = useReducer(authReducer, {
    user: null,
    isAuthenticated: false,
  });

  // React Compilerが自動最適化（useCallback/useMemo不要）
  const login = (user: User) => {
    dispatch({ type: 'LOGIN', payload: user });
  };

  const logout = () => {
    dispatch({ type: 'LOGOUT' });
  };

  const value = { state, login, logout };

  return <AuthContext value={value}>{children}</AuthContext>;
}

// Custom Hook for Context
function useAuth() {
  const context = useContext(AuthContext);

  if (context === undefined) {
    throw new Error('useAuth must be used within AuthProvider');
  }

  return context;
}

export { AuthProvider, useAuth };
```

## 6. フォームハンドリング（React Hook Form + Zod）

**型安全なフォームバリデーション**

```typescript
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';

// Zodスキーマ定義
const contractFormSchema = z.object({
  studentName: z.string().min(1, '生徒名は必須です').max(50, '生徒名は50文字以内で入力してください'),
  courseType: z.enum(['individual', 'group'], {
    required_error: 'コース種別を選択してください',
  }),
  startDate: z.string().min(1, '開始日は必須です'),
  monthlyFee: z.number().min(0, '月額料金は0以上で入力してください'),
});

// 型推論
type ContractFormInput = z.infer<typeof contractFormSchema>;

/**
 * 契約登録フォームコンポーネント
 *
 * @param props - コンポーネントのProps
 * @param props.onSubmit - フォーム送信時のハンドラ
 * @returns フォームコンポーネント
 */
interface ContractFormProps {
  onSubmit: (data: ContractFormInput) => void;
  defaultValues?: Partial<ContractFormInput>;
}

function ContractForm({ onSubmit, defaultValues }: ContractFormProps) {
  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<ContractFormInput>({
    resolver: zodResolver(contractFormSchema),
    defaultValues,
  });

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      <div>
        <label htmlFor="studentName" className="block text-sm font-medium">
          生徒名 <span className="text-red-500">*</span>
        </label>
        <input
          {...register('studentName')}
          id="studentName"
          type="text"
          className="mt-1 block w-full rounded-md border-gray-300"
          aria-invalid={errors.studentName ? 'true' : 'false'}
          aria-describedby={errors.studentName ? 'studentName-error' : undefined}
        />
        {errors.studentName && (
          <p id="studentName-error" className="mt-1 text-sm text-red-600" role="alert">
            {errors.studentName.message}
          </p>
        )}
      </div>

      <div>
        <label htmlFor="courseType" className="block text-sm font-medium">
          コース種別 <span className="text-red-500">*</span>
        </label>
        <select
          {...register('courseType')}
          id="courseType"
          className="mt-1 block w-full rounded-md border-gray-300"
          aria-invalid={errors.courseType ? 'true' : 'false'}
        >
          <option value="">選択してください</option>
          <option value="individual">個別指導</option>
          <option value="group">集団指導</option>
        </select>
        {errors.courseType && (
          <p className="mt-1 text-sm text-red-600" role="alert">
            {errors.courseType.message}
          </p>
        )}
      </div>

      <button
        type="submit"
        disabled={isSubmitting}
        className="px-4 py-2 bg-blue-600 text-white rounded-md disabled:bg-gray-400"
      >
        {isSubmitting ? '送信中...' : '登録'}
      </button>
    </form>
  );
}

export { ContractForm };
```

## 7. TanStack Query ガイド

### クエリキーの命名規則

**階層的な構造を持たせる**

```typescript
// ✅ 良い例: 階層的なクエリキー
const queryKeys = {
  all: ['contracts'] as const,
  lists: () => [...queryKeys.all, 'list'] as const,
  list: (filters: ContractFilters) => [...queryKeys.lists(), filters] as const,
  details: () => [...queryKeys.all, 'detail'] as const,
  detail: (id: string) => [...queryKeys.details(), id] as const,
};

// 使用例
useQuery({
  queryKey: queryKeys.detail('contract-123'),
  queryFn: () => fetchContract('contract-123'),
});

// キャッシュ無効化
queryClient.invalidateQueries({ queryKey: queryKeys.lists() });
queryClient.invalidateQueries({ queryKey: queryKeys.detail('contract-123') });
```

### オプティミスティック更新

**ユーザー体験を向上させる楽観的更新**

```typescript
/**
 * 契約ステータスを更新するカスタムフック
 */
function useUpdateContractStatus() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: (params: { contractId: string; status: ContractStatus }) =>
      updateContractStatus(params.contractId, params.status),

    // オプティミスティック更新
    onMutate: async ({ contractId, status }) => {
      // 進行中のクエリをキャンセル
      await queryClient.cancelQueries({ queryKey: ['contract', contractId] });

      // 以前のデータを保存
      const previousContract = queryClient.getQueryData(['contract', contractId]);

      // 楽観的にキャッシュを更新
      queryClient.setQueryData(['contract', contractId], (old: Contract) => ({
        ...old,
        status,
      }));

      // ロールバック用のデータを返す
      return { previousContract };
    },

    // エラー時: ロールバック
    onError: (err, variables, context) => {
      if (context?.previousContract) {
        queryClient.setQueryData(
          ['contract', variables.contractId],
          context.previousContract
        );
      }
    },

    // 成功時: キャッシュを再取得
    onSuccess: (data, variables) => {
      queryClient.invalidateQueries({ queryKey: ['contract', variables.contractId] });
    },
  });
}

export { useUpdateContractStatus };
```

### エラーハンドリング

**適切なエラー処理**

```typescript
/**
 * 契約一覧を表示するコンポーネント
 */
function ContractList() {
  const {
    data: contracts,
    isLoading,
    error,
    refetch,
  } = useQuery({
    queryKey: ['contracts'],
    queryFn: fetchContracts,
    retry: 3, // 3回までリトライ
    retryDelay: (attemptIndex) => Math.min(1000 * 2 ** attemptIndex, 30000),
  });

  // 早期リターン: ローディング中
  if (isLoading) {
    return <LoadingSpinner />;
  }

  // 早期リターン: エラー発生
  if (error) {
    return (
      <div className="p-4 bg-red-50 rounded-md">
        <h3 className="text-red-800 font-medium">データの取得に失敗しました</h3>
        <p className="text-red-600 text-sm mt-1">{error.message}</p>
        <button
          onClick={() => refetch()}
          className="mt-2 px-3 py-1 bg-red-600 text-white rounded-md text-sm"
        >
          再試行
        </button>
      </div>
    );
  }

  // 早期リターン: データが空
  if (!contracts || contracts.length === 0) {
    return (
      <div className="text-center py-8 text-gray-500">
        契約データがありません
      </div>
    );
  }

  return (
    <div className="space-y-4">
      {contracts.map((contract) => (
        <ContractCard key={contract.id} contract={contract} />
      ))}
    </div>
  );
}

export { ContractList };
```

## 8. パフォーマンス最適化

### コード分割（React.lazy + Suspense）

**ページごとにバンドルを分割**

```typescript
import { lazy, Suspense } from 'react';
import { BrowserRouter, Routes, Route } from 'react-router-dom';

import { LoadingSpinner } from '@/components/common/LoadingSpinner';

// 遅延ロード
const ContractSearchPage = lazy(() => import('@/pages/contract/ContractSearchPage'));
const ContractDetailPage = lazy(() => import('@/pages/contract/ContractDetailPage'));
const ContractRegisterPage = lazy(() => import('@/pages/contract/ContractRegisterPage'));

/**
 * アプリケーションルーター
 */
function AppRouter() {
  return (
    <BrowserRouter>
      <Suspense fallback={<LoadingSpinner />}>
        <Routes>
          <Route path="/contracts" element={<ContractSearchPage />} />
          <Route path="/contracts/:id" element={<ContractDetailPage />} />
          <Route path="/contracts/new" element={<ContractRegisterPage />} />
        </Routes>
      </Suspense>
    </BrowserRouter>
  );
}

export { AppRouter };
```

