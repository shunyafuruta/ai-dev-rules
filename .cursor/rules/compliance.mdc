## 行政システム向けコンプライアンス

### NISC（内閣サイバーセキュリティセンター）ガイドライン対応

#### 政府情報システムセキュリティ要件

```typescript
/**
 * 政府情報システムのセキュリティレベル
 */
type SecurityLevel = '機密性1' | '機密性2' | '機密性3';

/**
 * セキュリティレベルに応じた暗号化アルゴリズム
 */
const ENCRYPTION_ALGORITHMS = {
  機密性1: 'aes-128-gcm', // 一般情報
  機密性2: 'aes-256-gcm', // 機微情報
  機密性3: 'aes-256-gcm', // 機密情報（追加の物理セキュリティ必要）
} as const;

/**
 * セキュリティレベルに応じたデータ暗号化
 *
 * @param data - 暗号化するデータ
 * @param level - セキュリティレベル
 */
function encryptBySecurityLevel(data: string, level: SecurityLevel): string {
  const algorithm = ENCRYPTION_ALGORITHMS[level];

  // セキュリティレベルに応じた暗号化処理
  // （実装は security.mdc の encrypt 関数を参照）

  return encrypt(data); // 実際はアルゴリズムを選択
}

export { encryptBySecurityLevel };
```

### 電子署名法対応

#### 電子署名の実装

```typescript
import crypto from 'crypto';

/**
 * 電子署名を生成
 *
 * @param data - 署名対象データ
 * @param privateKey - 秘密鍵
 * @returns 電子署名（Base64エンコード）
 */
function signData(data: string, privateKey: string): string {
  const sign = crypto.createSign('RSA-SHA256');
  sign.update(data);
  sign.end();

  const signature = sign.sign(privateKey, 'base64');
  return signature;
}

/**
 * 電子署名を検証
 *
 * @param data - 署名対象データ
 * @param signature - 電子署名（Base64エンコード）
 * @param publicKey - 公開鍵
 * @returns 署名が有効ならtrue
 */
function verifySignature(data: string, signature: string, publicKey: string): boolean {
  const verify = crypto.createVerify('RSA-SHA256');
  verify.update(data);
  verify.end();

  const isValid = verify.verify(publicKey, signature, 'base64');
  return isValid;
}

export { signData, verifySignature };
```

