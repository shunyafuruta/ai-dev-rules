# コンプライアンス規約

**対象業界**: 医療、金融、行政

このドキュメントは、各業界の法令・規制に準拠するための実装ガイドラインを提供します。

---

## 共通コンプライアンス要件

### 個人情報保護法対応

**日本の個人情報保護法に準拠**

#### 個人情報の定義

以下は個人情報として厳格に管理する必要があります：

- 氏名
- 生年月日
- 住所
- 電話番号
- メールアドレス
- マイナンバー
- 顔写真
- 指紋、虹彩などの生体情報

#### 個人情報の取得

```typescript
/**
 * 個人情報の取得時に利用目的を明示
 */
interface PersonalDataConsent {
  userId: string;
  purpose: string; // 利用目的
  consentedAt: Date; // 同意日時
  ipAddress: string; // 同意時のIPアドレス
  userAgent: string; // 同意時のUser-Agent
}

/**
 * 個人情報取得時の同意記録
 *
 * @param userId - ユーザーID
 * @param purpose - 利用目的
 */
async function recordConsent(userId: string, purpose: string): Promise<void> {
  await db.personalDataConsent.create({
    data: {
      userId,
      purpose,
      consentedAt: new Date(),
      ipAddress: getClientIP(),
      userAgent: getUserAgent(),
    },
  });
}

export { recordConsent };
```

#### 個人情報の第三者提供

```typescript
/**
 * 個人情報の第三者提供記録
 */
interface ThirdPartyDisclosure {
  userId: string;
  recipientName: string; // 提供先名称
  purpose: string; // 提供目的
  dataItems: string[]; // 提供項目
  disclosedAt: Date; // 提供日時
  userConsent: boolean; // 本人同意の有無
}

/**
 * 第三者提供を記録
 *
 * @param userId - ユーザーID
 * @param recipientName - 提供先
 * @param purpose - 提供目的
 * @param dataItems - 提供する情報項目
 * @param userConsent - 本人同意の有無
 */
async function recordThirdPartyDisclosure(
  userId: string,
  recipientName: string,
  purpose: string,
  dataItems: string[],
  userConsent: boolean
): Promise<void> {
  await db.thirdPartyDisclosure.create({
    data: {
      userId,
      recipientName,
      purpose,
      dataItems: JSON.stringify(dataItems),
      disclosedAt: new Date(),
      userConsent,
    },
  });

  // 監査ログに記録
  await logAudit('THIRD_PARTY_DISCLOSURE', userId, 'personal_data', 'disclose', {
    recipientName,
    purpose,
    dataItems,
    userConsent,
  });
}

export { recordThirdPartyDisclosure };
```

#### 本人からの開示請求対応

```typescript
/**
 * 保有個人データの開示請求に対応
 *
 * @param userId - ユーザーID
 * @returns 個人データのエクスポート
 */
async function exportPersonalData(userId: string): Promise<PersonalDataExport> {
  const user = await db.user.findUnique({
    where: { id: userId },
    include: {
      contracts: true,
      payments: true,
      loginHistory: {
        orderBy: { loginAt: 'desc' },
        take: 100,
      },
    },
  });

  // 早期リターン: ユーザーが存在しない
  if (!user) {
    throw new NotFoundError('USER_NOT_FOUND', 'ユーザーが見つかりません');
  }

  // 機密情報を除外してエクスポート
  const exportData = {
    personalInfo: {
      name: user.name,
      email: user.email,
      phoneNumber: user.phoneNumber,
      address: user.address,
      createdAt: user.createdAt,
      updatedAt: user.updatedAt,
    },
    contracts: user.contracts.map((contract) => ({
      contractNumber: contract.contractNumber,
      status: contract.status,
      startDate: contract.startDate,
      endDate: contract.endDate,
    })),
    payments: user.payments.map((payment) => ({
      amount: payment.amount,
      paidAt: payment.paidAt,
      status: payment.status,
    })),
    loginHistory: user.loginHistory.map((login) => ({
      loginAt: login.loginAt,
      ipAddress: login.ipAddress,
    })),
  };

  // 開示請求を記録
  await logAudit('PERSONAL_DATA_EXPORT', userId, 'personal_data', 'export', {
    requestedAt: new Date(),
  });

  return exportData;
}

export { exportPersonalData };
```

#### 削除請求（忘れられる権利）

```typescript
/**
 * 個人情報の削除（論理削除）
 *
 * @param userId - ユーザーID
 */
async function deletePersonalData(userId: string): Promise<void> {
  // ソフトデリート（30日間の猶予期間）
  await db.user.update({
    where: { id: userId },
    data: {
      deletedAt: new Date(),
      // 個人情報を仮名化
      name: '削除済みユーザー',
      email: `deleted_${userId}@example.com`,
      phoneNumber: null,
      address: null,
    },
  });

  // 削除請求を記録
  await logAudit('PERSONAL_DATA_DELETION', userId, 'personal_data', 'delete', {
    deletedAt: new Date(),
    retentionPeriodDays: 30,
  });
}

/**
 * 個人情報の完全削除（30日後）
 *
 * @param userId - ユーザーID
 */
async function permanentlyDeletePersonalData(userId: string): Promise<void> {
  // 関連データを全て削除
  await db.$transaction([
    db.contract.deleteMany({ where: { userId } }),
    db.payment.deleteMany({ where: { userId } }),
    db.loginHistory.deleteMany({ where: { userId } }),
    db.session.deleteMany({ where: { userId } }),
    db.user.delete({ where: { id: userId } }),
  ]);

  // 完全削除を記録（監査ログは保持）
  await logAudit('PERSONAL_DATA_PERMANENT_DELETION', userId, 'personal_data', 'permanent_delete', {
    deletedAt: new Date(),
  });
}

export { deletePersonalData, permanentlyDeletePersonalData };
```

