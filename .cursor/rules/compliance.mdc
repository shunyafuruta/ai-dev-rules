### マネーロンダリング対策

#### 疑わしい取引の検知

```typescript
/**
 * 疑わしい取引のフラグ
 */
const SUSPICIOUS_TRANSACTION_THRESHOLD = 1000000; // 100万円以上
const RAPID_TRANSACTION_INTERVAL_MINUTES = 5; // 5分以内の連続取引
const RAPID_TRANSACTION_COUNT = 10; // 10回以上

/**
 * 疑わしい取引を検知
 *
 * @param userId - ユーザーID
 * @param amount - 取引金額
 */
async function detectSuspiciousTransaction(userId: string, amount: number): Promise<void> {
  const suspicious = [];

  // 高額取引の検知
  if (amount >= SUSPICIOUS_TRANSACTION_THRESHOLD) {
    suspicious.push('高額取引');
  }

  // 短時間に連続した取引の検知
  const recentTransactions = await db.transaction.findMany({
    where: {
      userId,
      transactionDate: {
        gte: new Date(Date.now() - RAPID_TRANSACTION_INTERVAL_MINUTES * 60 * 1000),
      },
    },
  });

  if (recentTransactions.length >= RAPID_TRANSACTION_COUNT) {
    suspicious.push('短時間に連続した取引');
  }

  // 疑わしい取引として記録
  if (suspicious.length > 0) {
    await db.suspiciousActivity.create({
      data: {
        userId,
        amount,
        reason: suspicious.join(', '),
        detectedAt: new Date(),
        status: 'pending_review',
      },
    });

    // 監査ログに記録
    await logAudit('SUSPICIOUS_TRANSACTION_DETECTED', userId, 'transaction', 'detect_suspicious', {
      amount,
      reason: suspicious,
    });

    // アラート通知（管理者に通知）
    await notifyAdmins('疑わしい取引が検知されました', {
      userId,
      amount,
      reason: suspicious,
    });
  }
}

export { detectSuspiciousTransaction };
```

