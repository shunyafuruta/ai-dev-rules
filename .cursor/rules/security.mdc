## データ保護

### 個人情報の取り扱い

**個人情報保護法・GDPR準拠**

```typescript
/**
 * 個人情報の種別
 */
type PersonalDataType = 'name' | 'email' | 'phone' | 'address' | 'medical' | 'financial';

/**
 * 個人情報を仮名化する
 *
 * @param data - 個人情報
 * @param type - 情報種別
 * @returns 仮名化されたデータ
 */
function pseudonymize(data: string, type: PersonalDataType): string {
  switch (type) {
    case 'email':
      // example@domain.com → e***e@d***n.com
      const [localPart, domain] = data.split('@');
      const maskedLocal = localPart[0] + '***' + localPart[localPart.length - 1];
      const [domainName, tld] = domain.split('.');
      const maskedDomain = domainName[0] + '***' + domainName[domainName.length - 1];
      return `${maskedLocal}@${maskedDomain}.${tld}`;

    case 'phone':
      // 090-1234-5678 → 090-****-5678
      return data.replace(/(\d{3})-?\d{4}-?(\d{4})/, '$1-****-$2');

    case 'name':
      // 山田太郎 → 山田**
      return data.substring(0, 2) + '**';

    default:
      return '***';
  }
}

export { pseudonymize };
```

### データ保持・削除ポリシー

**データライフサイクル管理**

```typescript
/**
 * 個人情報の保持期間（日数）
 */
const DATA_RETENTION_DAYS = {
  LOGIN_HISTORY: 90, // ログイン履歴: 90日
  AUDIT_LOG: 365 * 7, // 監査ログ: 7年（法令対応）
  DELETED_USER: 30, // 削除済みユーザー: 30日（復元猶予期間）
  SESSION: 1, // セッション: 1日
} as const;

/**
 * 保持期限切れのデータを削除する（定期実行）
 */
async function purgeExpiredData(): Promise<void> {
  const now = new Date();

  // ログイン履歴の削除
  const loginHistoryCutoff = new Date(
    now.getTime() - DATA_RETENTION_DAYS.LOGIN_HISTORY * 24 * 60 * 60 * 1000
  );
  await db.loginHistory.deleteMany({
    where: { loginAt: { lt: loginHistoryCutoff } },
  });

  // 期限切れセッションの削除
  const sessionCutoff = new Date(
    now.getTime() - DATA_RETENTION_DAYS.SESSION * 24 * 60 * 60 * 1000
  );
  await db.session.deleteMany({
    where: { lastActivityAt: { lt: sessionCutoff } },
  });

  // 削除済みユーザーの完全削除
  const deletedUserCutoff = new Date(
    now.getTime() - DATA_RETENTION_DAYS.DELETED_USER * 24 * 60 * 60 * 1000
  );
  await db.user.deleteMany({
    where: {
      deletedAt: { not: null, lt: deletedUserCutoff },
    },
  });

  console.log('期限切れデータの削除が完了しました');
}

export { purgeExpiredData };
```

