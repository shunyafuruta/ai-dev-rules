## パフォーマンス最適化

### 1. ページネーション

```typescript
const PAGE_SIZE = 20;

/**
 * ページネーション付きで契約一覧を取得
 *
 * @param page - ページ番号（1から始まる）
 */
async function getContractsPaginated(page: number) {
  const [contracts, total] = await Promise.all([
    db.contracts.findMany({
      skip: (page - 1) * PAGE_SIZE,
      take: PAGE_SIZE,
      orderBy: { created_at: 'desc' },
    }),
    db.contracts.count(),
  ]);

  return {
    data: contracts,
    pagination: {
      page,
      pageSize: PAGE_SIZE,
      total,
      totalPages: Math.ceil(total / PAGE_SIZE),
    },
  };
}

export { getContractsPaginated };
```

### 2. カーソルベースページネーション（大規模データ）

```typescript
/**
 * カーソルベースページネーション
 *
 * @param cursor - 前ページの最後のID
 * @param limit - 取得件数
 */
async function getContractsCursorBased(cursor?: string, limit: number = 20) {
  const contracts = await db.contracts.findMany({
    take: limit,
    skip: cursor ? 1 : 0,
    cursor: cursor ? { id: cursor } : undefined,
    orderBy: { created_at: 'desc' },
  });

  return {
    data: contracts,
    nextCursor: contracts.length === limit ? contracts[contracts.length - 1].id : null,
  };
}

export { getContractsCursorBased };
```

### 3. 集計クエリの最適化

```typescript
/**
 * ダッシュボード統計を取得（最適化版）
 */
async function getDashboardStats() {
  // 並列実行で高速化
  const [totalContracts, activeContracts, totalRevenue] = await Promise.all([
    db.contracts.count(),
    db.contracts.count({ where: { status: 'active' } }),
    db.payments.aggregate({
      _sum: { amount: true },
      where: { status: 'paid' },
    }),
  ]);

  return {
    totalContracts,
    activeContracts,
    totalRevenue: totalRevenue._sum.amount || 0,
  };
}

export { getDashboardStats };
```

