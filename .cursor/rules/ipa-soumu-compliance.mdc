## 総務省ガイドライン対応

### 「地方公共団体における情報セキュリティポリシーに関するガイドライン」対応

#### 1. アクセスログの記録

```typescript
/**
 * アクセスログを記録
 */
async function logAccess(
  userId: string,
  resource: string,
  action: string,
  result: 'success' | 'failure',
  details?: Record<string, unknown>
): Promise<void> {
  await db.accessLog.create({
    data: {
      userId,
      resource,
      action,
      result,
      ipAddress: getClientIP(),
      userAgent: getUserAgent(),
      timestamp: new Date(),
      details: details ? JSON.stringify(details) : null,
    },
  });
}

// 使用例
await logAccess(user.id, 'contract', 'read', 'success', { contractId: contract.id });
await logAccess(user.id, 'user', 'delete', 'failure', { reason: 'permission_denied' });

export { logAccess };
```

#### 2. パスワードポリシー

```typescript
import { z } from 'zod';

/**
 * 総務省推奨のパスワード要件
 */
const PASSWORD_MIN_LENGTH = 12; // 12文字以上（推奨）
const PASSWORD_REQUIRE_COMPLEXITY = true;

const StrongPasswordSchema = z
  .string()
  .min(PASSWORD_MIN_LENGTH, `パスワードは${PASSWORD_MIN_LENGTH}文字以上で入力してください`)
  .regex(/[A-Z]/, '大文字を1文字以上含めてください')
  .regex(/[a-z]/, '小文字を1文字以上含めてください')
  .regex(/[0-9]/, '数字を1文字以上含めてください')
  .regex(/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/, '記号を1文字以上含めてください');

/**
 * パスワード履歴チェック（過去5世代）
 */
async function checkPasswordHistory(userId: string, newPassword: string): Promise<boolean> {
  const passwordHistory = await db.passwordHistory.findMany({
    where: { userId },
    orderBy: { createdAt: 'desc' },
    take: 5,
  });

  for (const history of passwordHistory) {
    const isSame = await bcrypt.compare(newPassword, history.passwordHash);
    if (isSame) {
      throw new Error('過去5回に使用したパスワードは使用できません');
    }
  }

  return true;
}

export { StrongPasswordSchema, checkPasswordHistory };
```

#### 3. 多要素認証（MFA）の実装

```typescript
import speakeasy from 'speakeasy';
import qrcode from 'qrcode';

/**
 * MFA秘密鍵を生成
 */
async function generateMFASecret(userId: string, userEmail: string): Promise<{
  secret: string;
  qrCodeUrl: string;
}> {
  const secret = speakeasy.generateSecret({
    name: `MyApp (${userEmail})`,
    issuer: 'MyApp',
  });

  // QRコードを生成
  const qrCodeUrl = await qrcode.toDataURL(secret.otpauth_url!);

  // 秘密鍵を暗号化して保存
  await db.user.update({
    where: { id: userId },
    data: { mfaSecret: encrypt(secret.base32) },
  });

  return {
    secret: secret.base32,
    qrCodeUrl,
  };
}

/**
 * MFAトークンを検証
 */
async function verifyMFAToken(userId: string, token: string): Promise<boolean> {
  const user = await db.user.findUnique({ where: { id: userId } });

  if (!user || !user.mfaSecret) {
    return false;
  }

  // 秘密鍵を復号化
  const secret = decrypt(user.mfaSecret);

  // トークンを検証
  const isValid = speakeasy.totp.verify({
    secret,
    encoding: 'base32',
    token,
    window: 1, // 前後30秒の時間差を許容
  });

  return isValid;
}

export { generateMFASecret, verifyMFAToken };
```

### 「クラウドサービス提供における情報セキュリティ対策ガイドライン」対応

#### 1. データの暗号化（保存時・通信時）

```typescript
import crypto from 'crypto';

// 暗号化設定
const ENCRYPTION_ALGORITHM = 'aes-256-gcm';
const ENCRYPTION_KEY = process.env.ENCRYPTION_KEY!; // 32バイト

/**
 * データを暗号化（保存時暗号化）
 */
function encryptData(plaintext: string): string {
  const iv = crypto.randomBytes(16);
  const cipher = crypto.createCipheriv(ENCRYPTION_ALGORITHM, ENCRYPTION_KEY, iv);

  const encrypted = Buffer.concat([
    cipher.update(plaintext, 'utf8'),
    cipher.final(),
  ]);

  const authTag = cipher.getAuthTag();

  // IV + 認証タグ + 暗号文 をBase64エンコード
  const result = Buffer.concat([iv, authTag, encrypted]);
  return result.toString('base64');
}

/**
 * データを復号化
 */
function decryptData(ciphertext: string): string {
  const data = Buffer.from(ciphertext, 'base64');

  const iv = data.subarray(0, 16);
  const authTag = data.subarray(16, 32);
  const encrypted = data.subarray(32);

  const decipher = crypto.createDecipheriv(ENCRYPTION_ALGORITHM, ENCRYPTION_KEY, iv);
  decipher.setAuthTag(authTag);

  const decrypted = Buffer.concat([
    decipher.update(encrypted),
    decipher.final(),
  ]);

  return decrypted.toString('utf8');
}

export { encryptData, decryptData };
```

#### 2. バックアップとリカバリ

```typescript
/**
 * データベースバックアップ
 */
async function backupDatabase(): Promise<void> {
  const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
  const backupFile = `backup-${timestamp}.sql`;

  // PostgreSQLの場合
  await execCommand(`pg_dump ${process.env.DATABASE_URL} > ${backupFile}`);

  // バックアップを暗号化
  const encryptedBackup = await encryptFile(backupFile);

  // クラウドストレージにアップロード
  await uploadToS3(encryptedBackup, `backups/${backupFile}.enc`);

  logger.info('Database backup completed', { backupFile });
}

/**
 * データベースリストア
 */
async function restoreDatabase(backupFile: string): Promise<void> {
  // バックアップをダウンロード
  const encryptedBackup = await downloadFromS3(`backups/${backupFile}.enc`);

  // 復号化
  const decryptedBackup = await decryptFile(encryptedBackup);

  // リストア
  await execCommand(`psql ${process.env.DATABASE_URL} < ${decryptedBackup}`);

  logger.info('Database restored', { backupFile });
}

export { backupDatabase, restoreDatabase };
```

