## 統合テスト

### APIエンドポイントのテスト

```typescript
import { describe, it, expect, beforeAll, afterAll } from 'vitest';
import request from 'supertest';
import app from '@/app';

describe('GET /api/contracts/:id', () => {
  const testUserId = 'test-user-123';
  const testContractId = 'test-contract-123';
  const authToken = '...'; // テスト用認証トークン

  beforeAll(async () => {
    // テストデータを準備
    await createTestContract(testContractId, testUserId);
  });

  afterAll(async () => {
    // テストデータをクリーンアップ
    await deleteTestContract(testContractId);
  });

  it('正常系: 契約情報を取得できる', async () => {
    const response = await request(app)
      .get(`/api/contracts/${testContractId}`)
      .set('Authorization', `Bearer ${authToken}`)
      .expect(200);

    expect(response.body.id).toBe(testContractId);
    expect(response.body.studentId).toBe(testUserId);
  });

  it('異常系: 存在しない契約IDの場合、404エラーを返す', async () => {
    const response = await request(app)
      .get('/api/contracts/invalid-id')
      .set('Authorization', `Bearer ${authToken}`)
      .expect(404);

    expect(response.body.error).toBe('契約が見つかりません');
  });

  it('異常系: 認証トークンがない場合、401エラーを返す', async () => {
    await request(app).get(`/api/contracts/${testContractId}`).expect(401);
  });
});
```

