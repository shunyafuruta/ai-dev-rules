## デプロイメント通知

### Slack通知

```typescript
/**
 * デプロイメント通知をSlackに送信
 */
async function notifyDeployment(
  environment: 'staging' | 'production',
  version: string,
  status: 'started' | 'success' | 'failed'
): Promise<void> {
  const webhookUrl = process.env.SLACK_WEBHOOK_URL;

  if (!webhookUrl) {
    return;
  }

  const color = status === 'success' ? 'good' : status === 'failed' ? 'danger' : 'warning';
  const emoji = status === 'success' ? ':white_check_mark:' : status === 'failed' ? ':x:' : ':rocket:';

  const message = {
    attachments: [
      {
        color,
        title: `${emoji} Deployment ${status}`,
        fields: [
          {
            title: 'Environment',
            value: environment,
            short: true,
          },
          {
            title: 'Version',
            value: version,
            short: true,
          },
          {
            title: 'Time',
            value: new Date().toISOString(),
            short: false,
          },
        ],
      },
    ],
  };

  await fetch(webhookUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(message),
  });
}

export { notifyDeployment };
```

