## エラー追跡（Sentry連携）

### Sentryセットアップ

```typescript
import * as Sentry from '@sentry/node';

/**
 * Sentryを初期化
 */
Sentry.init({
  dsn: process.env.SENTRY_DSN,
  environment: process.env.NODE_ENV,
  tracesSampleRate: 0.1, // 10%のトランザクションをサンプリング
});

/**
 * Sentryエラーハンドラ
 */
function sentryErrorHandler(err: Error, req: Request, res: Response, next: NextFunction): void {
  // Sentryにエラーを送信
  Sentry.captureException(err, {
    user: {
      id: req.user?.id,
      email: req.user?.email,
    },
    extra: {
      method: req.method,
      url: req.url,
      body: req.body,
    },
  });

  next(err);
}

export { sentryErrorHandler };
```

