## トランザクション管理

### トランザクションの基本

```typescript
/**
 * 契約を作成し、支払いスケジュールを登録する（トランザクション）
 *
 * @param contractData - 契約データ
 * @param paymentSchedule - 支払いスケジュール
 */
async function createContractWithPayments(
  contractData: ContractInput,
  paymentSchedule: PaymentScheduleInput[]
): Promise<Contract> {
  // トランザクションを開始
  const result = await db.$transaction(async (tx) => {
    // 契約を作成
    const contract = await tx.contracts.create({
      data: contractData,
    });

    // 支払いスケジュールを登録
    await tx.payment_schedules.createMany({
      data: paymentSchedule.map((schedule) => ({
        contract_id: contract.id,
        due_date: schedule.dueDate,
        amount: schedule.amount,
      })),
    });

    return contract;
  });

  return result;
}

export { createContractWithPayments };
```

### 楽観的ロック（Optimistic Locking）

```prisma
model contracts {
  id              String   @id @default(uuid())
  contract_number String
  status          String
  version         Int      @default(0) // バージョン番号
  updated_at      DateTime @updatedAt
}
```

```typescript
/**
 * 楽観的ロックを使用した契約更新
 *
 * @param contractId - 契約ID
 * @param currentVersion - 現在のバージョン
 * @param updateData - 更新データ
 */
async function updateContractWithOptimisticLock(
  contractId: string,
  currentVersion: number,
  updateData: ContractUpdateInput
): Promise<Contract> {
  const updated = await db.contracts.updateMany({
    where: {
      id: contractId,
      version: currentVersion, // バージョンが一致する場合のみ更新
    },
    data: {
      ...updateData,
      version: { increment: 1 }, // バージョンをインクリメント
    },
  });

  // 更新件数が0の場合は競合が発生
  if (updated.count === 0) {
    throw new ConflictError('他のユーザーによって更新されています。再度読み込んでください。');
  }

  const contract = await db.contracts.findUnique({ where: { id: contractId } });
  return contract!;
}

export { updateContractWithOptimisticLock };
```

