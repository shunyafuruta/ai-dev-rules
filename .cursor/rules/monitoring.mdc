## アプリケーションパフォーマンス監視（APM）

### レスポンスタイム計測

```typescript
/**
 * パフォーマンス計測ミドルウェア
 */
function performanceMiddleware(req: Request, res: Response, next: NextFunction): void {
  const startTime = Date.now();

  // レスポンス送信後に計測
  res.on('finish', () => {
    const duration = Date.now() - startTime;

    // 遅いリクエストを警告
    if (duration > 1000) {
      logger.warn('Slow request detected', {
        method: req.method,
        url: req.url,
        duration,
      });
    }

    // パフォーマンスメトリクスを記録
    recordMetric('http_request_duration_ms', duration, {
      method: req.method,
      route: req.route?.path,
      statusCode: res.statusCode,
    });
  });

  next();
}

export { performanceMiddleware };
```

### データベースクエリ監視

```typescript
/**
 * Prismaクエリログ
 */
const db = new PrismaClient({
  log: [
    {
      emit: 'event',
      level: 'query',
    },
  ],
});

db.$on('query', (e) => {
  // 遅いクエリを警告
  if (e.duration > 100) {
    logger.warn('Slow database query', {
      query: e.query,
      duration: e.duration,
      params: e.params,
    });
  }
});

export { db };
```

