## 医療業界向けコンプライアンス

### 医療法・個人情報保護法対応

#### 医療情報の厳格な管理

```typescript
/**
 * 医療情報（要配慮個人情報）
 */
interface MedicalRecord {
  patientId: string;
  diagnosisDate: Date;
  diagnosis: string; // 暗号化必須
  treatment: string; // 暗号化必須
  medication: string; // 暗号化必須
  doctor: string;
  hospital: string;
  encryptedData: string; // 暗号化されたデータ
}

/**
 * 医療情報を暗号化して保存
 *
 * @param patientId - 患者ID
 * @param medicalData - 医療情報
 */
async function saveMedicalRecord(
  patientId: string,
  medicalData: {
    diagnosis: string;
    treatment: string;
    medication: string;
    doctor: string;
    hospital: string;
  }
): Promise<void> {
  // 医療情報を暗号化
  const encryptedData = encrypt(JSON.stringify(medicalData));

  await db.medicalRecord.create({
    data: {
      patientId,
      diagnosisDate: new Date(),
      encryptedData,
      doctor: medicalData.doctor,
      hospital: medicalData.hospital,
    },
  });

  // アクセスログを記録（監査証跡）
  await logAudit('MEDICAL_RECORD_CREATED', patientId, 'medical_record', 'create', {
    doctor: medicalData.doctor,
    hospital: medicalData.hospital,
  });
}

/**
 * 医療情報を復号化して取得
 *
 * @param recordId - 医療記録ID
 * @param requesterId - アクセス者のID
 * @returns 医療情報
 */
async function getMedicalRecord(recordId: string, requesterId: string): Promise<MedicalRecord> {
  const record = await db.medicalRecord.findUnique({
    where: { id: recordId },
  });

  // 早期リターン: 記録が存在しない
  if (!record) {
    throw new NotFoundError('MEDICAL_RECORD_NOT_FOUND', '医療記録が見つかりません');
  }

  // アクセス権限チェック
  const hasAccess = await checkMedicalRecordAccess(requesterId, record.patientId);
  if (!hasAccess) {
    await logAudit('MEDICAL_RECORD_ACCESS_DENIED', requesterId, 'medical_record', 'access_denied', {
      recordId,
      patientId: record.patientId,
    });
    throw new ForbiddenError('この医療記録にアクセスする権限がありません');
  }

  // 復号化
  const decryptedData = JSON.parse(decrypt(record.encryptedData));

  // アクセスログを記録
  await logAudit('MEDICAL_RECORD_ACCESSED', requesterId, 'medical_record', 'access', {
    recordId,
    patientId: record.patientId,
  });

  return {
    patientId: record.patientId,
    diagnosisDate: record.diagnosisDate,
    ...decryptedData,
  };
}

export { saveMedicalRecord, getMedicalRecord };
```

#### 医療従事者による閲覧制限

```typescript
/**
 * 医療従事者の権限チェック
 *
 * @param userId - 医療従事者ID
 * @param patientId - 患者ID
 * @returns アクセス権限の有無
 */
async function checkMedicalRecordAccess(userId: string, patientId: string): Promise<boolean> {
  const user = await db.user.findUnique({ where: { id: userId } });

  // 医療従事者ではない場合は拒否
  if (!user || !['doctor', 'nurse', 'admin'].includes(user.role)) {
    return false;
  }

  // 担当患者かどうかをチェック
  const assignment = await db.patientAssignment.findFirst({
    where: {
      medicalStaffId: userId,
      patientId,
      // 有効期間内
      startDate: { lte: new Date() },
      OR: [{ endDate: null }, { endDate: { gte: new Date() } }],
    },
  });

  return assignment !== null;
}

export { checkMedicalRecordAccess };
```

